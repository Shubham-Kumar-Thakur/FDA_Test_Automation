<?xml version="1.0" encoding="UTF-8"?>

<!--
  FBS-only suite: runs all TC_FBS_00X tests (currently 001-012) sequentially, without any of
  the TC_FBO_* tests from the main testng.xml.
  Usage: mvn test -DsuiteXmlFile=src/test/resources/testng_fbs.xml

  All 12 classes live in a single <test> block (not one <test> per class) so that
  @BeforeGroups("FBS")/@AfterGroups("FBS") in BaseClass fire exactly once for the whole run —
  TestNG re-runs group configuration methods at every <test> boundary, so splitting these into
  separate <test> tags caused FDA to log out and back in between every single TC_FBS test
  (confirmed via a live run on 2026-09-09; see CLAUDE.md).
-->

<suite name="FDA Automation Suite - FBS Only" verbose="1" thread-count="1" preserve-order="true">

    <listeners>
        <listener
            class-name="FDA_Automation_Script.FDA_Automation_Script.listeners.TestNGListener" />
        <listener
            class-name="FDA_Automation_Script.FDA_Automation_Script.listeners.ExtentReportListener" />
    </listeners>

    <!-- ═══════════════════════════════════════════════════════════
         TC_FBS_001-012: all FBS tests share one <test> block so FDA logs in once
         (@BeforeGroups("FBS")) before TC_FBS_001 and logs out once (@AfterGroups("FBS"))
         after TC_FBS_012 — see comment above.
         ═══════════════════════════════════════════════════════════ -->
    <test name="TC_FBS_001-012 - FBS Store Full Fulfillment Suite" preserve-order="true">
        <classes>
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_001_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_002_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_003_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_004_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_005_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_006_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_007_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_008_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_009_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_010_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_011_Test" />
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_012_Test" />
        </classes>
    </test>

</suite>
