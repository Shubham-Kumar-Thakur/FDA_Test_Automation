<?xml version="1.0" encoding="UTF-8"?>

<!--
  Single-test run: TC_FBS_002 only.
  Usage: mvn test -DsuiteXmlFile=src/test/resources/testng_fbs002.xml
-->

<suite name="FDA Automation Suite - TC_FBS_002 Only" verbose="1" thread-count="1" preserve-order="true">

    <listeners>
        <listener
            class-name="FDA_Automation_Script.FDA_Automation_Script.listeners.TestNGListener" />
        <listener
            class-name="FDA_Automation_Script.FDA_Automation_Script.listeners.ExtentReportListener" />
    </listeners>

    <!-- ═══════════════════════════════════════════════════════════
         TC_FBS_002: FBS 2 Products (1 3P Seller) Full Fulfillment
         FDA 2 SKUs qty=1 each (Credit Card) → Mirakl Accept → Kibo (verify FBS)
         → Mirakl Invoice Upload → DHL Tracking → Mark as Shipped → Entregado → Received
         ═══════════════════════════════════════════════════════════ -->
    <test name="TC_FBS_002 - FBS Store 2 Products Full Fulfillment" preserve-order="true">
        <classes>
            <class
                name="FDA_Automation_Script.FDA_Automation_Script.tests.TC_FBS_002_Test" />
        </classes>
    </test>

</suite>
