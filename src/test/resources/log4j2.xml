<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" packages="FDA_Automation_Script.FDA_Automation_Script.appenders">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
        </Console>
        <File name="FileAppender" fileName="test-output/logs/automation.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
        </File>
        <ExtentReport name="ExtentReportAppender"/>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="ExtentReportAppender"/>
        </Root>
    </Loggers>
</Configuration>
